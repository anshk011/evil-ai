# ============================================
# VADER-GEM Telegram Bot — Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Telegram Bot Token
# Get your token from @BotFather on Telegram
# https://core.telegram.org/bots#botfather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# API Provider Selection ('omniroute' or 'openrouter')
API_PROVIDER=omniroute

# OmniRoute Gateway Configuration
# Default local endpoint provided by OmniRoute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute-default-key

# OpenRouter API Configuration (Used as fallback or primary if API_PROVIDER=openrouter)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Fast Model Selection (default: deepseek/deepseek-chat)
# Recommended fast models:
# - deepseek/deepseek-chat
# - google/gemini-2.5-flash
# - meta-llama/llama-3.3-70b-instruct
# - omni-auto
MODEL_NAME=deepseek/deepseek-chat

# Bot Personality (optional)
BOT_NAME=VADER-GEM
